NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database?appName=AppName
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REDIS_URL=
ENABLE_REDIS=false
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60
MOCK_AI=false
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
AI_MODEL_FALLBACKS=gemini:gemini-3.1-flash-lite
ALLOW_LOCAL_AI_FALLBACK=true
# Bounded retries for temporary failures; 429 responses enter a cooldown.
AI_REQUEST_TIMEOUT_MS=12000
AI_TOTAL_TIMEOUT_MS=25000
AI_MAX_ATTEMPTS=2
REQUIRE_LLM_QUESTIONS=true
OPENAI_API_KEY=
OPENAI_MODEL=
INTERVIEWER_PERSONA=professional
STT_PROVIDER=gemini
OPENAI_WHISPER_MODEL=whisper-1
TTS_PROVIDER=mock
TTS_MODEL=tts-1
TTS_VOICE=onyx
MOCK_STT=false
MOCK_TTS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="your-email@example.com"
DEEPGRAM_API_KEY=your-deepgram-api-key
